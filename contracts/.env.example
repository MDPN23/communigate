# CommuniGate -- Smart Contract Environment
# Copy this to .env and fill in your values

# ---------------------------------------------------------------
# DEPLOYER
# ---------------------------------------------------------------
# Your deployer wallet private key (WITHOUT 0x prefix)
PRIVATE_KEY=

# ---------------------------------------------------------------
# ETH SEPOLIA
# ---------------------------------------------------------------
# RPC URL from Alchemy / Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Etherscan API key for contract verification
# Get at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------
# ARBITRUM SEPOLIA
# ---------------------------------------------------------------
# RPC URL from Alchemy / Infura
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Arbiscan API key for contract verification
# Get at: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=
